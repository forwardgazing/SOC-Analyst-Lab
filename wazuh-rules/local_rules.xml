<group name="syslog,linux,windows,">
  <!-- ======================================================= -->
  <!-- КЕЙС 1: ДЕТЕКТИРОВАНИЕ ЗАКРЕПЛЕНИЯ (PERSISTENCE)        -->
  <!-- ======================================================= -->

  <!-- 1. Базовое правило: Ловим создание любого пользователя -->
  <rule id="100200" level="8">
    <if_sid>5902</if_sid> 
    <description>INFO: New user created on Linux system.</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- 2. Продвинутое правило: Ловим подозрительные имена -->
  <rule id="100201" level="12">
    <if_sid>100200</if_sid>
    <match>admin|root|backup|test</match>
    <description>CRITICAL: Suspicious user created (Possible Persistence)!</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- 3. Правило: Добавление пользователя в группу sudo -->
  <rule id="100202" level="12">
    <if_sid>5901</if_sid>
    <match>sudo</match>
    <description>CRITICAL: User added to sudo group (Privilege Escalation)!</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- 4. КОРРЕЛЯЦИЯ: Если создано 3 пользователя за 1 минуту - это атака! -->
  <rule id="100203" level="14" frequency="3" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>CRITICAL: Mass user creation detected (Possible automated backdoor deployment)!</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- ======================================================= -->
  <!-- КЕЙС 2: СНИЖЕНИЕ ШУМА ДЛЯ LINUX                         -->
  <!-- ======================================================= -->
  
  <rule id="100400" level="0">
    <if_sid>510</if_sid>
    <description>Silencing rootcheck scan noise</description>
  </rule>

  <rule id="100500" level="0">
    <if_sid>5501, 5502</if_sid>
    <description>Silencing PAM session noise</description>
  </rule>

  <rule id="100501" level="0">
    <if_sid>502, 503, 506</if_sid>
    <description>Silencing Wazuh agent start/stop</description>
  </rule>

  <!-- ======================================================= -->
  <!-- КЕЙС 3: АКТИВНОЕ РЕАГИРОВАНИЕ (ACTIVE RESPONSE)         -->
  <!-- ======================================================= -->
  
  <rule id="100310" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Custom: Brute force detected (3 attempts). Blocking IP.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- ======================================================= -->
  <!-- КЕЙС 4: EDR-МОНИТОРИНГ ПРОЦЕССОВ (AUDITD)               -->
  <!-- ======================================================= -->
  
  <rule id="100320" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">suspicious_activity</field>
    <description>EDR: Suspicious process execution (Nmap) detected on endpoint.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>edr,audit,</group>
  </rule>

  <!-- ======================================================= -->
  <!-- КЕЙС 6: СНИЖЕНИЕ ШУМА ДЛЯ WINDOWS (RULE TUNING)         -->
  <!-- ======================================================= -->
  
  <!-- Глушим шум от легитимного использования net.exe -->
  <rule id="100600" level="0">
    <if_sid>92039</if_sid>
    <description>Silencing net.exe account discovery noise</description>
  </rule>

  <!-- Глушим шум от общих проверок Discovery -->
  <rule id="100601" level="0">
    <if_sid>92031</if_sid>
    <description>Silencing generic Discovery activity noise</description>
  </rule>

  <!-- Глушим успешные входы в систему (в лаборатории) -->
  <rule id="100602" level="0">
    <if_sid>60106</if_sid>
    <description>Silencing Windows logon success noise</description>
  </rule>

  <!-- Глушим фоновую службу защиты -->
  <rule id="100603" level="0">
    <if_sid>60642</if_sid>
    <description>Silencing Software protection service noise</description>
  </rule>
</group>
