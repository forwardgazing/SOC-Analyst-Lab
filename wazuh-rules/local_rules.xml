<group name="syslog,windows,">
  <!-- КЕЙС 1: ДЕТЕКТИРОВАНИЕ ЗАКРЕПЛЕНИЯ (PERSISTENCE) -->
  <rule id="100200" level="12">
    <match>useradd</match>
    <description>CRITICAL: New user created on Linux system (Possible Persistence)!</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <rule id="100201" level="12">
    <match>usermod</match>
    <match>sudo</match>
    <description>CRITICAL: User added to sudo group (Privilege Escalation)!</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- КЕЙС 2: СНИЖЕНИЕ ШУМА (NOISE REDUCTION) -->
  <rule id="100400" level="0">
    <if_sid>510</if_sid>
    <description>Silencing rootcheck scan noise</description>
  </rule>

  <rule id="100500" level="0">
    <if_sid>5501, 5502</if_sid>
    <description>Silencing PAM session noise</description>
  </rule>

  <rule id="100501" level="0">
    <if_sid>502, 503, 506</if_sid>
    <description>Silencing Wazuh agent start/stop</description>
  </rule>
</group>
